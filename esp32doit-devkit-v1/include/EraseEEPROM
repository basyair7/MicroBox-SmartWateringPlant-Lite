#pragma once

#include <Arduino.h>
#include <EEPROM.h>

/**
 * @class EraseEEPROM
 * @brief EEPROMの内容を消去するためのシングルトンクラス。
 * 
 * このクラスは、EEPROMの内容をすべてゼロに書き換える機能を提供します。
 * ESP32やESP8266などのプラットフォームで動作し、必要に応じてEEPROMのサイズを指定して初期化できます。
 * シングルトンパターンを採用しており、インスタンスは1つだけ存在します。
 */
class EraseEEPROM {
    size_t ___eeprom_size;  ///< EEPROMのサイズを格納する変数（ESP32/ESP8266用）。
    bool __check_begin;     ///< EEPROMの初期化が成功したかどうかを示すフラグ。
    bool __process = false; ///< EEPROM消去処理が完了したかどうかを示すフラグ。

    public:
        /**
         * @brief EEPROMを指定されたサイズで初期化する。
         * @details ESP32やESP8266では、EEPROMのサイズを指定して初期化する必要があります。
         *          Arduinoボードでは、EEPROMのサイズは固定されているため、サイズの指定は無視されます。
         * 
         * @param size EEPROMのサイズ（バイト単位）。ESP32/ESP8266でのみ使用され、Arduinoでは無視されます。デフォルトは512バイト。
         * @return 初期化が成功した場合は true、それ以外の場合は false を返す。
         */
        bool begin(size_t size = 512) {
            #if defined(ESP32)
                this->___eeprom_size = size;
                this->__check_begin = EEPROM.begin(this->___eeprom_size);
            #elif defined(ESP8266)
                this->__eeprom_size = size;
                EEPROM.begin(this->__eeprom_size);
                this->__check_begin = true;
            #else
                // ArduinoボードではEEPROMのサイズは固定されているため、サイズの指定は無視される。
                this->__eeprom_size = size;
                this->__check_begin = true;
            #endif

            return this->__check_begin;
        }

        /**
         * @brief EEPROMの内容をすべて消去する。
         * @details このメソッドは、EEPROMのすべてのバイトをゼロに書き換えます。
         *          ESP32やESP8266では、EEPROMのサイズに基づいて消去処理が行われます。
         *          Arduinoボードでは、EEPROMの全長を消去します。
         * 
         * @return 消去処理が成功した場合は true、それ以外の場合は false を返す。
         */
        bool run() {
            if (!this->__check_begin) 
                return false; // EEPROMが初期化されていない場合は処理を行わない。

            if (this->__process) 
                return true; // すでに消去処理が完了している場合は再度処理を行わない。
            
            #if defined(ESP32) || defined(ESP8266)
                // ESP32やESP8266では、指定されたサイズのEEPROMを消去する。
                for (size_t i = 0; i < this->___eeprom_size; i++)
                    EEPROM.write(i, 0);
                this->__process = EEPROM.commit(); // ESP32/ESP8266では、変更を保存するためにcommit()を呼び出す必要がある。
            #else
                // Arduinoボードでは、EEPROMの全長を消去する。
                for (size_t i = 0; i < EEPROM.length(); i++)
                    EEPROM.write(i, 0);
                this->__process = true; // Arduinoではcommit()は不要なので、消去処理が完了したとみなす。
            #endif

            return this->__process;
        }

    public:
        /**
         * @brief EraseEEPROMクラスのシングルトンインスタンスを取得する。
         * @return EraseEEPROM& シングルトンインスタンスへの参照。
         */
        static EraseEEPROM &instance() {
            static EraseEEPROM instance;
            return instance;
        }

        /**
         * @brief EEPROMを指定されたサイズで初期化する（静的メソッド）。
         * @param size EEPROMのサイズ（バイト単位）。ESP32/ESP8266でのみ使用され、Arduinoでは無視されます。デフォルトは512バイト。
         * @return bool 初期化が成功した場合は true、それ以外の場合は false を返す。
         */
        static bool BEGIN(size_t size = 512) {
            return instance().begin(size);
        }

        /**
         * @brief EEPROMの内容をすべて消去する（静的メソッド）。
         * @return bool 消去処理が成功した場合は true、それ以外の場合は false を返す。
         */
        static bool RUN() {
            return instance().run();
        }
};