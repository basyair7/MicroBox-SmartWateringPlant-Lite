#pragma once

#include <Arduino.h>
#include <LiquidCrystal_I2C.h>
#include <LiquidCrystal_animated.h>

/**
 * @class LCDdisplay
 * @brief LCDディスプレイを操作するためのクラスです。I2C通信を使用してLCDを制御します。
 * @details このクラスは、LCDの初期化、テキストの表示、カーソル位置の設定、およびバックライトの制御などの機能を提供します。LCDの列数と行数は、コンストラクタで指定できます。
 */
class LCDdisplay {
    LiquidCrystal_I2C _lcd_obj; ///< LiquidCrystal_I2Cオブジェクトを使用してLCDを制御します。

    public:
        int cols = 16; ///< LCDディスプレイの列数「れつすう」
        int rows = 2;  ///< LCDディスプレイの行数「ぎょうすう」

        /**
         * @brief LCDディスプレイのコンストラクタです。LCDの列数と行数を指定して初期化します。
         * @param cols LCDの列数（デフォルトは16列）。
         * @param rows LCDの行数（デフォルトは2行）。 
         */
        LCDdisplay(int cols = 16, int rows = 2) : 
            cols(cols), rows(rows), _lcd_obj(0x27, cols, rows) {}

        /**
         * @brief LCDディスプレイを初期化します。LCDの初期化、バックライトのオン、および画面のクリアを行います。
         * @details この関数は、LCDの初期化を行い、バックライトをオンにし、画面をクリアします。LCDが正しく動作するために、最初にこの関数を呼び出す必要があります。
         *          LCDの列数と行数は、コンストラクタで指定された値に基づいて設定されます。
         */
        void init() {
            this->_lcd_obj.init(); //< LCDの初期化
            this->_lcd_obj.backlight(); //< LCDのバックライトをオンにする
            this->_lcd_obj.clear(); //< LCDの画面をクリアする
        }

        /**
         * @brief LCDディスプレイの画面をクリアします。
         * @details この関数は、LCDの画面をクリアして、すべてのテキストを消去します。画面を更新する前に、必要に応じてこの関数を呼び出すことができます。
         */
        void clear() {
            this->_lcd_obj.clear();
        }

        /**
         * @brief LCDディスプレイのバックライトをオンまたはオフにします。
         * @details この関数は、LCDのバックライトを制御します。引数xがtrueの場合、バックライトをオンにし、falseの場合はオフにします。バックライトの状態を変更することで、LCDの視認性を向上させることができます。
         * @param x バックライトの状態を指定するブール値。trueでオン、falseでオフになります。
         */
        void backlight(bool x) {
            if (x) this->_lcd_obj.backlight();
            else this->_lcd_obj.noBacklight();
        }

        /**
         * @brief LCDディスプレイのカーソル位置を設定します。
         * @details この関数は、LCDのカーソル位置を指定された列と行に設定します。列と行のインデックスは0から始まります。例えば、setCursor(0, 0)は左上の位置にカーソルを設定し、setCursor(15, 1)は右下の位置にカーソルを設定します。
         * @param col 列「れつ」インデックス（0から始まります）。
         * @param row 行「ぎょう」インデックス（0から始まります）。
         */
        void setCursor(const uint8_t col, const uint8_t row) {
            this->_lcd_obj.setCursor(col, row);
        }

        /**
         * @brief LCDディスプレイに値を表示します。
         * @details この関数は、LCDに指定された値を表示します。値の型はテンプレートパラメータTで指定され、任意の型の値を表示できます。LCDにテキストを表示するために、この関数を使用して値を渡すことができます。
         * @tparam T 表示する値の型。
         * @param x 表示する値。任意の型の値を指定できます。
         */
        template <typename T>
        void print(const T &x) {
            this->_lcd_obj.print(x);
        }

        /**
         * @brief LCDディスプレイに値を表示し、カーソル位置を指定します。
         * @details この関数は、LCDに指定された値を表示し、カーソル位置を指定します。値の型はテンプレートパラメータTで指定され、任意の型の値を表示できます。列と行のインデックスは0から始まります。例えば、print("Hello", 0, 0)は左上の位置に「Hello」を表示し、print("World", 15, 1)は右下の位置に「World」を表示します。
         * @tparam T 表示する値の型。
         * @param x 表示する値。任意の型の値を指定できます。
         * @param col 列インデックス（0から始まります）。
         * @param row 行インデックス（0から始まります）。
         */
        template <typename T>
        void print(const T &x, const uint8_t col, const uint8_t row)
        {
            this->_lcd_obj.setCursor(col, row);
            this->_lcd_obj.print(x);
        }
};