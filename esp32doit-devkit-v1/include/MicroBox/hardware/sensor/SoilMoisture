#pragma once

#include <Arduino.h>

class SoilMoisture {
    uint8_t _pinIN;             //< 土壌水分「どじょうすいぶん」センサーの入力ピン
    bool _CHECK_BEGIN = false;  //< begin()が呼び出されたかどうかを確認「かくにん」するフラグ

    public:
        int value;              //< 土壌水分の値「あたい」（0-100または生データ）を保存「ほぞん」するための変数「へんすう」

    public:
        /**
         * @brief 土壌水分センサーを初期化するための関数「かんすう」
         * @param pinIn 土壌水分センサーの出力「しゅつりょく」に接続「せつぞく」されたアナログピンの番号
         */
        void begin(const uint8_t pinIn) {
            this->_pinIN = pinIn;
            this->_CHECK_BEGIN = true;
            pinMode(pinIn, INPUT);
        }

        /**
         * @brief センサーから土壌水分「どじょうすいぶん」の値「あたい」を読み取る
         * @param mapping 値を0-100の範囲「はんい」にマッピングするかどうか（デフォルトはtrue）。falseの場合、生のセンサーデータが返されます。
         * @param map_min マッピングの最小値「さいしょうち」（デフォルトは0）。通常「つうじょう」、センサーの最小生「さいしょうなま」データ値「あたい」に設定「せってい」されます。
         * @param map_max マッピングの最大値「さいだいち」（デフォルトは4095）。通常「つうじょう」、センサーの最大生「さいだいなま」データ値「あたい」に設定「せってい」されます。
         */
        void getData(bool mapping = true, uint32_t wet = 0, uint32_t dry = 4095)
        {
            // begin()が呼び出されていない場合は、エラーメッセージを表示「ひょうじ」し、値「あたい」を-1に設定します。
            if (!this->_CHECK_BEGIN) {
                Serial.println(F("Error: Soil Moisture not initialize! Call begin() first"));
                this->value = -1;
                return;
            }

            // センサーから生の値を読み取ります。
            int raw_result = analogRead(this->_pinIN);
            
            // mappingがtrueの場合、raw_resultを0-100の範囲「はんい」にマッピングします。そうでない場合は、生の値をそのまま使用「しよう」します。
            if (mapping) {
                this->value = map(raw_result, wet, dry, 100, 0);
                this->value = constrain(this->value, 0, 100);
            }
            else {
                this->value = raw_result;
            }
        }
};