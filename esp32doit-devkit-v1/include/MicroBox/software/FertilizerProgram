#pragma once

#include <Arduino.h>
#include "variable"
#include "MyEEPROM"
#include "../hardware/DS3231rtc"

// ================= DEBUG CONFIG =================
#define DEBUG_MODE 0

#if DEBUG_MODE
    #define DAY_SECONDS 60UL        // 一日 ＝ 60秒 （テスト用に短縮）
    #define MIX_TIMEOUT 10UL        // 混合タイムアウト ＝ 10秒 （テスト用に短縮）
    #define PUMP_DURATION 10UL      // ポンプ運転時間 ＝ 10秒 （テスト用に短縮）
#else
    #define DAY_SECONDS 86400UL
    #define MIX_TIMEOUT 300UL
#endif
// ===============================================

enum FertilizerState {
    IDLE,
    MIXING,
    PUMPING,
    FINISHED
};

class FertilizerProgram {
    MyEEPROM __myeeprom; //!< EEPROMユーティリティモジュール
    
    // ---- ハードウェア ----
    uint8_t _pumpPin, _motorPin;
    bool on = false, off = true;
    
    // ---- フリップフロップ回路を用いてポンプの状態を切り替える。 ----
    unsigned long _pumpPreviousTime = 0; // ポンプ運転の時間管理
    bool _pumpState = false; // ポンプの状態（オン／オフ）
    
    // ---- State ----
    FertilizerState _state = IDLE;
    uint32_t _mixStartUnix;

    bool FertilizerChecked, _isManualStart;

    // ---- RTC経過時間 ----
    uint32_t lastFertilizerDay;
    uint32_t _pumpStartUnix;

    public:
        const char* stateToString() const {
            switch (this->_state) {
                case IDLE: return "IDLE";
                case MIXING: return "MIXING";
                case PUMPING: return "PUMPING";
                case FINISHED: return "FINISHED";
                default: return "UNKNOWN"; 
            }
        }

        void forceStart();

        void begin(const uint8_t pumpPin, const uint8_t motorPin, bool _optocouple = true);
        void run(uint8_t hour, uint32_t minute);

        uint32_t getNextFertilizerDay();
        uint32_t getDaysPassed();
        uint32_t getDaysRemaining();
        

    private:
        void run_pump(bool state);
        void run_motor(bool state);

        void mix_fertilizer();
        void give_fertilizer(bool _run);

        uint32_t getNow();
};