        }

        /**
         * @brief JSONのデシリアライズに失敗した場合のエラーハンドリング関数。
          例えば、JSONドキュメントの形式が正しくない場合や、必要なフィールドが欠落している場合などに呼び出されます。
         * @param program プログラムの名前やコンテキストを示す文字列。
          例えば、"WiFiConfig"や"StateConfig"など、どのプログラムや設定に関連するエラーかを示す文字列を指定できます。
         * @param msg エラーメッセージの内容を示す文字列。
          例えば、"Invalid JSON format"や"Missing required field 'SSID'"など、具体的なエラーの内容を示す文字列を指定できます。
          この関数は、JSONのデシリアライズに失敗した場合に、プログラム名とエラーメッセージをシリアルモニタに出力することで、デバッグや問題の特定に役立ちます。
         */
        void handleError_deserializeJson(const String &program, const String &msg)
        {
            Serial.println(F("Failed to deserializeJson"));
            Serial.print(F("Program : "));
            Serial.println(program);
            Serial.print(F("Message : "));
            Serial.println(msg);
        }
