#pragma once

#include <Arduino.h>
#include <EEPROM.h>
#include "variable"

class MyEEPROM {
    public:
        /**
         * @brief EEPROM を使用できるように初期化（しょきか）します。ESPプラットフォームで必要です。
         * @param size EEPROM のサイズ（バイト単位）。ESP32 では 512、ESP8266 では 512 または 1024 を推奨します。
         * @return EEPROM の初期化に成功した場合は `true`、失敗した場合は `false` を返します。
         */
        bool initialize(int size = 512) {
            #if defined(ESP32)
                // ESP32では、EEPROM.begin(size)は成功（せいこう）または失敗（しっぱい）を示（しめ）すブール値（ち）を返します。
                return EEPROM.begin(size);
            #elif defined(ESP8266)
                // ESP8266では、EEPROM.begin(size)は値（あたい）を返しません（ボイド型です）。
                EEPROM.begin(size); return true; // エラーチェックができないため、成功前提（せいこうぜんてい）とします。
            #else
                // AVRプラットフォームでは、初期化（しょきか）は不要です。
                return true;
            #endif
        }

        /**
         * @brief EEPROM を終了（しゅうりょう）します。ESPプラットフォームで必要です。
         * @return EEPROM の終了に成功した場合は `true`、失敗した場合は `false` を返します。
         */
        bool cleanup() const {
            #if defined(ESP32)
                EEPROM.end(); return true;
            #elif defined(ESP8266)
                return EEPROM.end();
            #else
                return false;
            #endif
        }

    public:
        /**
         * @brief EEPROM から型 T の値（あたい）を読み取ります。
         * @tparam T 読み取る値の型。
         * @param address EEPROM のアドレス。
         * @param val 読み取った値を格納（かくのう）する変数（へんすう）への参照（さんしょう）。
         * @return 読み取りに成功（せいこう）した場合は参照（さんしょう）された変数を返し、失敗（しっぱい）した場合は未定義（みていぎ）の動作（どうさ）になります。
         */
        template <typename T>
        T &get(const int address, T &val) const {
            return EEPROM.get(address, val);
        }

        /**
         * @brief EEPROM から 1 バイトを読み取ります。
         * @param address EEPROM のアドレス。
         * @return EEPROM から読み取ったバイト値。
         */
        uint8_t read(const int address) const {
            return EEPROM.read(address);
        }

        /**
         * @brief EEPROM に型 T の値を書き込みます。
         * @tparam T 書き込む値の型。
         * @param address EEPROM のアドレス。
         * @param state 書き込む値。
         * @return 書き込みに成功（せいこう）した場合は `true`、失敗（しっぱい）した場合は `false` を返します。
         */
        template <typename T>
        bool save_state(const int address, const T &state) const {
            EEPROM.put(address, state);
            #if defined(ESP32) || defined(ESP8266)
                return EEPROM.commit();
            #else
                return true;
            #endif
        }

        /**
         * @brief Blynk モードの状態（じょうたい）を EEPROM に保存（ほぞん）します。
         * @tparam T 保存する状態の型（かた）。
         * @param state 保存する状態。
         * @return 保存に成功（せいこう）した場合は `true`、失敗（しっぱい）した場合は `false` を返します。
         */
        template <typename T>
        bool save_wifi_state(const T &state) const {
            return this->save_state(ADDR_EEPROM_WIFI_MODE, state);
        }
};