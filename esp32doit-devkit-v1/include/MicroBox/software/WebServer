#pragma once

#include <Arduino.h>
#include <AsyncTCP.h>
#include <WiFi.h>
#include <ESPAsyncWebServer.h>
#include <ESPmDNS.h>
#include <ElegantOTA.h>
#include <ArduinoJson.h>
#include "info.h"
#include "LFSMemory"
#include "variable"
#include "../externobj"

#define APPJSON   "application/json"
#define TEXTHTML  "text/html"
#define TEXTPLAIN "text/plain"


class WebServerClass : protected Info {
    // プライベートメンバ変数
    const String DIRHTML = "/WEB/html/"; ///< HTMLファイルを格納するディレクトリ
    const String DIRCSS  = "/WEB/css/";  ///< CSSファイルを格納するディレクトリ
    const String DIRJS   = "/WEB/js/";   ///< JSSファイルを格納するディレクトリ

    File file;                  ///< ファイル操作用「そうさよう」のファイルオブジェクト
    String LocalIP;             ///< サーバーのローカルIPアドレス
    IPAddress clientIP;         ///< クライアントのIPアドレス
    int port;                   ///< サーバーのポート番号
    AsyncWebServer serverAsync; ///< 非同期「ひどうき」Webサーバーのインスタンス
    AsyncWebSocket ws;          ///< 非同期 WebSokectのインスタンス
    MyEEPROM myeeprom_obj;      ///< EEPROMハンドラオブジェクト

    public:
        /**
         * @brief 指定されたポートでWebサーバーを初期化するコンストラクタ
         * @param port Webサーバーのポート番号（デフォルト：80）
         */
        WebServerClass(int port = 80) : serverAsync(port), ws("/ws") {
            this->port = port;
        }

        /**
         * @brief Webサーバ、mDNS、およびElegantOTAを初期化する。
         */
        void ServerInit(void);

        /**
         * @brief ElegantOTAの更新ループ
         */
        void UpdateOTAloop(void);

    private:
        // Webサーバーの各種「かくしゅ」機能処理「きのうしょり」用プライベートメソッド

        /**
         * @brief CSSおよびJavaScriptファイルの提供「ていきょう」を行う。
         */
        void run_css_js_webserver(void);

        /**
         * @brief ルーティングを処理する。
         */
        void Routes(void);
        void RoutesSystem(void);
        void RoutesRelay(void);

        /**
         * @brief リカバリーページを配信する。
         * @param req Webサーバーのリクエストへのポインタ。
         */
        void RecoveryPage(AsyncWebServerRequest *req);

        /**
         * @brief インデックスページを配信する。
         * @param req Webサーバーのリクエストへのポインタ。
         */
        void index(AsyncWebServerRequest *req);
        void DataWebServer(AsyncWebServerRequest *req);
        void GetDataServer(DynamicJsonDocument &doc);

        /**
         * @brief Blynkを有効にする。
         * @param req Webサーバーのリクエストへのポインタ。
         */
        void EnableBlynk(AsyncWebServerRequest *req);

        /**
         * @brief システムを再起動する。
         * @param req Webサーバーのリクエストへのポインタ。
         */
        void RebootSys(AsyncWebServerRequest *req);

        /**
         * @brief システムをリセットする。
         * @param req Webサーバーのリクエストへのポインタ。
         */
        void ResetSys(AsyncWebServerRequest *req);

        /**
         * @brief WiFiの自動切り替え設定を更新する。
         * @param req Webサーバーのリクエストへのポインタ。
         */
        void UpdateAutoChangeWiFi(AsyncWebServerRequest *req);

        /**
         * @brief WiFiの自動切り替え設定を取得する。
         * @param req Webサーバーのリクエストへのポインタ。
         */
        void handleNotFound(AsyncWebServerRequest *req);

        /**
         * @brief 指定されたファイルの内容を文字列として読み取る。
         * @param fileName 読み取るファイルの名前。
         * @return ファイルの内容を文字列として返す。ファイルが存在しない場合は空の文字列を返す。
         */
        String file_buffer(String fileName);

        void handleError_deserializeJson(
            const String &program,
            DeserializationError error,
            bool *errorState,
            int *statoCode = nullptr,
            String *res = nullptr
        );

    // WebSocket関連のプライベートメソッド
    private:
        void handleWebSocketMessage(void *args, uint8_t *data, size_t len);
        void onEvent(
            AsyncWebSocket *server, 
            AsyncWebSocketClient *client, 
            AwsEventType type,
            void *arg,
            uint8_t *data,
            size_t len
        );
        void handleDataServeWS(AsyncWebSocketClient *client);
        void handleToggleCheck(AsyncWebSocketClient *client, JsonDocument &doc);

    
    // WiFi設定関連のプライベートメソッド
    private:
        void WiFi_AP_Config_Main(AsyncWebServerRequest *req);
        void WiFi_STA_Config_Main(AsyncWebServerRequest *req);
        void Save_WiFi_AP_Config(AsyncWebServerRequest *req);
        void Save_WiFi_STA_Config(AsyncWebServerRequest *req);

        void wifi_ap_config_1(AsyncWebServerRequest *req);
        void wifi_ap_config_2(AsyncWebServerRequest *req);
        void wifi_sta_config_1(AsyncWebServerRequest *req);
        void wifi_sta_config_2(AsyncWebServerRequest *req);
    
    // RTC設定
    private:
        void RTC_Config_Main(AsyncWebServerRequest *req);
        void Save_RTC_Config(AsyncWebServerRequest *req);
        void __getRTCServer__(StaticJsonDocument<200> &doc);
        void RTCServer(AsyncWebServerRequest *req);
        void handleRTCServer(AsyncWebSocketClient *client);

    private:
        // 肥料設定関連のプライベートメソッド
        void Fertilizer_Config_Main(AsyncWebServerRequest *req);
        void Save_Fertilizer_Config(AsyncWebServerRequest *req);
        void Save_Fertilizer_ConfigTime(AsyncWebServerRequest *req);
        void W_page_app(AsyncWebServerRequest *req);

    private:
        void Watering_Config_Main(AsyncWebServerRequest *req);
        void Save_Watering_Config(AsyncWebServerRequest *req);
        void Save_Watering_ConfigTime(AsyncWebServerRequest *req);
    
    private:
        String RelayChecked(uint8_t pinRelay);
        void updateRelayState(int pinRelay, bool state);

        void readRelayState(AsyncWebServerRequest *req);
        void queryDataRelayStr(StaticJsonDocument<500> &doc);

        void checkRelayState(AsyncWebServerRequest *req);
        void queryDataRelay(AsyncWebServerRequest *req);
        void postRelay(
            AsyncWebServerRequest *req,
            uint8_t *data, size_t len, size_t index, size_t total
        );

        // 水やり関連のプライベートメソッド
        void AutoWatering(AsyncWebServerRequest *req);
        void ManualWatering(AsyncWebServerRequest *req);
        String stateChecked(bool x) {
            return x ? "checked" : "";
        }
};

#if !defined(NO_GLOBAL_INSTANCES) && !defined(NO_GLOBAL_WebServer)
/**
 * @brief グローバルなWebServerClassのインスタンス
 * このインスタンスは、Webサーバー機能を使用するためにプログラム全体でアクセス可能です。
 * このインスタンスを使用して、Webサーバーの初期化やルーティングの設定などを行うことができます。
 * 例:  WebServer.ServerInit(); // Webサーバーの初期化
 *      WebServer.UpdateOTAloop(); // OTA更新ループの呼び出し
 */
extern WebServerClass WebServer;
#endif