#pragma once

#include <Arduino.h>

// PIN I/O コンポーネント
// GPIO22 (I2C SCL) と GPIO21 (I2C SDA) は使用しないでください
#define BOOTBUTTON          0           ///< ブートボタンのピン
#define LED_RUNNING         BUILTIN_LED ///< 組み込みLEDインジケーターピン GPIO2
#define LED_WARNING         5

#define PIN_DHT             14          ///< DHTモジュールのピン
#define PIN_WATERTEMP       15          ///< 水温センサー (DS18B20) のピン
#define PIN_TDS             34          ///< TDSセンサーのピン
#define PIN_SMS             35          ///< 土壌水分センサーのピン

#define BTN_RELAY           12          ///< リレースイッチャーのピン
#define BTN_AUTOWATERING    13          ///< 自動灌水のピン（有効または無効）
#define BTN_DISPLAY         18          
#define BTN_BACKLIGHT       25          ///< バックライトのピン（有効または無効）

// リレーピンアウトを定義
#define RELAY1              26
#define RELAY2              27
#define RELAY_FERTILIZER    23
#define RELAY_MOTOR         4
#define VAR_SWITCH          "relay"

#define WATERING_LVL_MAX    80   //< 土壌水分に対する灌水レベルの最大値
#define WATERING_LVL_MIN    60   //< 土壌水分に対する灌水レベルの最小値

#define PPM_TARGET          1150  //< TDSの目標値 (PPM)
#define PPM_TOLERANCE       5   //< TDSの許容範囲 (PPM)

#define HOUR_FERTILIZER     8
#define MINUTE_FERTILIZER   18
#define INTERVAL_FERTILIZER 7    //< 肥料適用間隔（日数）


inline const uint16_t RELAY_PINS[2] = {
    RELAY1, RELAY2
};

inline const String VALUE_DEFAULT[2] {
    "Relay 1", "Relay 2"
};

// EEPROMアドレス定義
// EEPROM操作にとって重要なため、これらのアドレスを置き換えないでください
#define ADDR_EEPROM_WIFI_MODE     0x04 ///< Wi-Fiモードを保存するためのEEPROMアドレス
#define ADDR_EEPROM_BACKLIGHT_LCD 0x08
#define ADDR_EEPROM_AUTO_FERTILIZER 0x0C